# Copy this file to .env and fill in the values
PORT=5000
NODE_ENV=development

# Local MongoDB, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/flowspace

# Any long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin(s) allowed by CORS and Socket.io (comma separated)
CLIENT_URL=http://localhost:5173
